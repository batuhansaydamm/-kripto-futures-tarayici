# Testnet dışında bir adres yazmayın. Canlı mod bu ilk sürümde kod seviyesinde kapalıdır.
BINANCE_BASE_URL=https://testnet.binancefuture.com
# Sinyal üretimi gerçek, herkese açık Binance Futures piyasa verisinden yapılır.
MARKET_DATA_BASE_URL=https://fapi.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Önce true bırakılır. Gerçek Testnet emri için false yapılır.
DRY_RUN=true
BOT_ENABLED=false

# iPhone kontrol paneli giriş anahtarı. Uzun ve rastgele bir değer kullanın.
DASHBOARD_TOKEN=change-me-long-random-token

PORT=3000
SCAN_INTERVAL_MS=900000
MARGIN_USDT=50
LEVERAGE=10
MAX_TOTAL_TRADES=5
MAX_OPEN_POSITIONS=1
MAX_CONSECUTIVE_LOSSES=2
MAX_DAILY_LOSS_USDT=100
