NODE_ENV=production
PORT=3000

# Testnet is mandatory for the first phase.
BINANCE_ENV=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Must remain false until an explicit later live rollout.
LIVE_TRADING=false

# Protect mobile/dashboard -> backend requests.
BOT_CONTROL_TOKEN=replace-with-a-long-random-secret

TRADE_MARGIN_USDT=50
LEVERAGE=10
MAX_TOTAL_TRADES=5
MAX_OPEN_POSITIONS=1
MARGIN_TYPE=ISOLATED
POSITION_MODE=ONE_WAY

# Circuit breakers. Tune after dry-run evidence.
DAILY_LOSS_LIMIT_USDT=50
MAX_CONSECUTIVE_LOSSES=2
MAX_API_ERRORS=5

STATE_FILE=./data/state.json
