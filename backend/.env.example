# Testnet is mandatory for phase 1.
BINANCE_BASE_URL=https://demo-fapi.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Safety defaults
LIVE_TRADING=false
BOT_ENABLED=false
MARGIN_USDT=50
LEVERAGE=10
MARGIN_TYPE=ISOLATED
MAX_OPEN_POSITIONS=1
MAX_TOTAL_TRADES=5
MAX_DAILY_LOSS_USDT=50
MAX_CONSECUTIVE_LOSSES=3
MAX_API_ERRORS=5
RECV_WINDOW=5000
PORT=8080

# Persist this path on the cloud host with a volume.
STATE_FILE=./data/bot-state.json

# Optional shared token used by the mobile dashboard.
DASHBOARD_TOKEN=
